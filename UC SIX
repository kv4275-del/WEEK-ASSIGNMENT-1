public class OOPSBannerUC6 {

    // Static method for letter O
    public static String[] getO() {
        return new String[] {
            " ***** ",
            "*     *",
            "*     *",
            "*     *",
            " ***** "
        };
    }

    // Static method for letter P
    public static String[] getP() {
        return new String[] {
            "****** ",
            "*     *",
            "****** ",
            "*      ",
            "*      "
        };
    }

    // Static method for letter S
    public static String[] getS() {
        return new String[] {
            " ***** ",
            "*      ",
            " ***** ",
            "      *",
            " ***** "
        };
    }

    public static void main(String[] args) {

        // Build banner using reusable static methods
        String[] letter1 = getO();
        String[] letter2 = getO();
        String[] letter3 = getP();
        String[] letter4 = getS();

        // Loop-based rendering
        for (int i = 0; i < letter1.length; i++) {
            System.out.println(
                    letter1[i] + "  " +
                    letter2[i] + "  " +
                    letter3[i] + "  " +
                    letter4[i]
            );
        }
    }
}
